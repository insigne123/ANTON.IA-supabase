# Apollo is the only active lead provider. Do not use NEXT_PUBLIC_ for this
# secret or expose it to the browser.
APOLLO_API_KEY="replace-with-apollo-server-api-key"
LEADS_PROVIDER_DEFAULT="apollo"

# Use the exact same long random value as ENRICHMENT_SERVICE_SECRET in the root
# Next.js BFF. It is sent only in the x-api-secret-key server-to-server header.
ENRICHMENT_SERVICE_SECRET="replace-with-a-long-random-shared-secret"

# Optional bounded limits. The service clamps these values to safe ranges.
APOLLO_BACKEND_RATE_LIMIT_WINDOW_MS="60000"
APOLLO_BACKEND_LEAD_SEARCH_MAX_REQUESTS="20"
APOLLO_BACKEND_ENRICH_MAX_REQUESTS="60"
APOLLO_BACKEND_MAX_REQUEST_BYTES="65536"
APOLLO_BACKEND_MAX_SEARCH_RESULTS="100"
APOLLO_BACKEND_PROVIDER_TIMEOUT_MS="20000"
