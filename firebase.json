{
  "apphosting": {
    "backendId": "studio",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      ".firebase",
      ".env*",
      ".next",
      ".next-build",
      ".playwright-mcp",
      ".opencode",
      ".release-*",
      ".release-*/**",
      "opencode.json",
      "AGENTS.md",
      "supabase/.temp",
      "*.tsbuildinfo",
      "suplia-claude-*.png",
      "chrome-extension.pem",
      "antonia-extension-v1.1.zip",
      "firebase-debug.log",
      "docs/*results*.json",
      "docs/*audit-*.json",
      "firebase-debug.*.log"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "cmd /c npm --prefix functions run build"
    ]
  }
}
