# =========================================
# ANTON.IA local environment template
#
# Known project/deploy context from repo:
# - Firebase project id: leadflowai-3yjcy
# - App Hosting URL: https://studio--leadflowai-3yjcy.us-central1.hosted.app
#
# Notes:
# - Values marked as secrets should come from Firebase Secret Manager,
#   Supabase, Google Cloud, Azure, Apollo, OpenAI, etc.
# - Values already declared in apphosting.yaml are prefilled below when safe.
# =========================================

# =========================================
# Core app URLs
# =========================================
NEXT_PUBLIC_BASE_URL="http://localhost:9003"
NEXT_PUBLIC_APP_URL="http://localhost:9003"
APP_URL="http://localhost:9003"
CANONICAL_APP_URL="http://localhost:9003"

BACKEND_HOSTED_APP_URL="https://backend-antonia--backend-apollo-leads-prod.us-central1.hosted.app"
BACKEND_REDIRECT_URL=""
BACKEND_ONLY_MODE="false"
ANTONIA_NEXT_BACKUP_PROCESSING="false"

# =========================================
# UI / polling
# =========================================
NEXT_PUBLIC_SEARCH_POLL_INTERVAL_MS="4000"
NEXT_PUBLIC_SEARCH_MAX_POLL_MINUTES="20"
NEXT_PUBLIC_SEARCH_PAGE_SIZE="50"

# =========================================
# Supabase
# - NEXT_PUBLIC_* values can be copied from Supabase project settings > API
# - SUPABASE_SERVICE_ROLE_KEY is server-only and must never be exposed client-side
# =========================================
NEXT_PUBLIC_SUPABASE_URL="https://yfdelflsheurzaicwayi.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_URL="https://yfdelflsheurzaicwayi.supabase.co"

# =========================================
# App secrets / protection
# - These are usually stored in Firebase Secret Manager in production
# =========================================
INTERNAL_API_SECRET="change-me-with-a-long-random-secret"
CRON_SECRET="change-me-with-a-long-random-secret"
APOLLO_WEBHOOK_SECRET="change-me-with-a-long-random-secret"
TRACKING_WEBHOOK_SECRET=""
QUOTA_FALLBACK_SECRET="change-me-with-a-long-random-secret"

TOKEN_ENCRYPTION_SECRET=""
# Required server-only secret. Use a long, random, stable value; do not expose it to the client.
UNSUBSCRIBE_TOKEN_SECRET="change-me-with-a-long-random-secret"
UNSUBSCRIBE_TOKEN_TTL_DAYS="3650"
ENCRYPTION_KEY=""
PRIVACY_ADMIN_EMAILS="privacy@example.com"

# =========================================
# OAuth - Microsoft / Outlook
# - Public values can be read from Azure App Registration overview
# - Secret comes from Azure Certificates & secrets
# =========================================
NEXT_PUBLIC_AZURE_AD_CLIENT_ID="3826e4b9-f46e-48b7-aa7c-f06e11bd9686"
NEXT_PUBLIC_AZURE_AD_TENANT_ID="common"
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI="http://localhost:9003/outlook"
AZURE_AD_CLIENT_SECRET=""

# =========================================
# OAuth - Google / Gmail
# - Client ID and secret come from Google Cloud Console > OAuth credentials
# =========================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID="1083965020353-50m4ibu3c1f56qc00c5j128bfv0mlk91.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# =========================================
# AI
# - Production uses OpenAI.
# - OPENAI_API_KEY comes from OpenAI platform.
# =========================================
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.6-luna"
# Dedicated email model for draft flows.
OPENAI_EMAIL_MODEL="gpt-5.6-luna"

# SUPL.IA uses model routing by task complexity.
# Fast: classifications, high-volume tasks, low-cost chat and small edits.
OPENAI_FAST_MODEL="gpt-5.6-luna"
# Balanced: generic drafting and summaries.
OPENAI_BALANCED_MODEL="gpt-5.6-luna"
# Orchestrator: tool planning, pending actions, CRM/campaign/lead workflows.
OPENAI_ORCHESTRATOR_MODEL="gpt-5.6-terra"
# Reasoning: multi-step strategy, prioritization and complex commercial decisions.
OPENAI_REASONING_MODEL="gpt-5.6-terra"
# Report synthesis uses the reasoning tier.
NATIVE_RESEARCH_REPORT_MODEL="gpt-5.6-terra"
# Critical: high-risk automation, bulk actions, compliance-sensitive flows.
OPENAI_CRITICAL_MODEL="gpt-5.6-sol"
# Fallback if the selected tier is unavailable.
OPENAI_FALLBACK_MODEL="gpt-5.6-luna"

# SUPL.IA conversation context compaction.
# Below this estimate, the full conversation is sent to the model.
# Above it, older messages are summarized and the most recent messages remain verbatim.
SUPLIA_CONTEXT_COMPACT_THRESHOLD_TOKENS="150000"
SUPLIA_CONTEXT_RECENT_MESSAGES="12"
NEXT_PUBLIC_SUPLIA_ENABLED="true"
NEXT_PUBLIC_SUPLIA_SCHEDULED_ENABLED="false"
SUPLIA_EXTERNAL_CONTENT_GUARD="true"
NEXT_PUBLIC_OPPORTUNITIES_ENABLED="false"

# Legacy check still referenced by scripts/verify-production-config.mjs
# GOOGLE_GENAI_API_KEY=""

# =========================================
# Lead search / enrichment / webhooks
# =========================================
USE_APIFY="false"

APIFY_TOKEN=""
APIFY_APOLLO_ACTOR_ID="code_crafter/apollo-io-scraper"
APIFY_APOLLO_TASK_ID=""
APIFY_ACTOR_ID=""

APOLLO_API_KEY=""
ANYMAIL_FINDER_API_KEY=""
# Server-only web research provider for native research and SUPL.IA search tools.
# This adapter uses only SERPER_API_KEY; do not expose it through NEXT_PUBLIC_*.
SERPER_API_KEY=""
SERPER_TIMEOUT_MS="6000"
SERPER_MAX_RETRIES="1"
SERPER_RETRY_DELAY_MS="250"
ENRICHMENT_SERVICE_URL="https://backend-antonia--backend-apollo-leads-prod.us-central1.hosted.app/api/enrich"
ENRICHMENT_SERVICE_SECRET=""

DEBUG_API_ENABLED="false"
CONTACT_DEBUG="false"

# Optional aliases accepted by current code
API_SECRET_KEY=""
BACKEND_ENRICH_SECRET=""
APOLLO_WEBHOOK_URL=""
APOLLO_WEBHOOK_BASE_URL=""
APOLLO_PROFILE_WEBHOOK_URL=""
APOLLO_LINKEDIN_PROFILE_WEBHOOK_URL=""
LINKEDIN_PROFILE_WEBHOOK_URL=""
LEAD_SEARCH_WEBHOOK_BASE_URL=""

LEADS_DISABLE_EXTERNAL_FALLBACK="false"

# =========================================
# Worker / research / Firebase scheduler
# =========================================
ANTONIA_APP_URL=""
ANTONIA_LEAD_SEARCH_URL="https://backend-antonia--backend-apollo-leads-prod.us-central1.hosted.app/api/lead-search"
LEAD_SEARCH_URL=""

ANTONIA_LEAD_RESEARCH_URL="https://backend-antonia--backend-apollo-leads-prod.us-central1.hosted.app/api/lead-research"
LEAD_RESEARCH_URL=""

# Firebase scheduled Functions own Antonia and native research. The native research
# function uses this dedicated secret only to call the protected App Hosting bridge.
NATIVE_RESEARCH_ENABLED="true"
NATIVE_RESEARCH_INLINE="false"
NATIVE_RESEARCH_SCHEDULER_ENABLED="false"
NATIVE_RESEARCH_SCHEDULER_LIMIT="5"
LEAD_RESEARCH_WORKER_SECRET=""

# Shared only by Firebase Scheduled Functions and the protected Next.js scheduler
# bridges. Configure the same value in Firebase Secret Manager and the target app
# runtime (App Hosting or Vercel); never reuse CRON_SECRET or INTERNAL_API_SECRET.
FIREBASE_SCHEDULER_SECRET=""

# Optional defense-in-depth secrets for IAM-private Firebase manual endpoints.
# Do not reuse these as CRON_SECRET or in App Hosting/Vercel configuration.
ANTONIA_MANUAL_TICK_SECRET=""
NATIVE_RESEARCH_MANUAL_TICK_SECRET=""

# =========================================
# Test / scripts
# =========================================
ALLOW_HIGH_RISK="false"
ANTONIA_TEST_PORT="9020"
ANTONIA_REPORT_TEST_PORT="9022"
ANTONIA_EDIT_TEST_PORT="9021"
LINKEDIN_PROFILE_TEST_URL=""
LINKEDIN_PROFILE_TEST_USER_ID=""

