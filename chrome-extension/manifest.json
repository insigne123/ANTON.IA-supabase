{
    "manifest_version": 3,
    "name": "Anton.IA — LinkedIn Workspace",
    "version": "4.0.2",
    "minimum_chrome_version": "116",
    "description": "Guarda e investiga leads y prepara mensajes personalizados desde LinkedIn.",
    "permissions": ["tabs", "sidePanel", "storage"],
    "side_panel": { "default_path": "panel.html" },
    "host_permissions": [
        "https://www.linkedin.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:9003/*",
        "http://127.0.0.1:9003/*",
        "https://app.antonia.ai/*",
        "https://studio--leadflowai-3yjcy.us-central1.hosted.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/*"
            ],
            "js": [
                "content.js", "prospecting-content.js"
            ]
        },
        {
            "matches": [
                "http://localhost:3000/*",
                "http://127.0.0.1:3000/*",
                "http://localhost:9003/*",
                "http://127.0.0.1:9003/*",
                "https://app.antonia.ai/*",
                "https://studio--leadflowai-3yjcy.us-central1.hosted.app/*"
            ],
            "js": [
                "web_injector.js", "prospecting-bridge.js"
            ]
        }
    ],
    "action": {
        "default_title": "Abrir Anton.IA",
        "default_icon": "icon.png"
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "externally_connectable": {
        "matches": [
            "http://localhost:3000/*",
            "http://127.0.0.1:3000/*",
            "http://localhost:9003/*",
            "http://127.0.0.1:9003/*",
            "https://app.antonia.ai/*",
            "https://studio--leadflowai-3yjcy.us-central1.hosted.app/*"
        ]
    }
}
