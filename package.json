{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 9003",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "prebuild": "node scripts/check-fences.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-node-tests.mjs",
    "test:env:local": "node scripts/setup-local-test-env.mjs",
    "test:env:nonprod": "node scripts/setup-nonprod-test-env.mjs",
    "test:identity:ensure": "node scripts/bootstrap-test-identities.mjs",
    "test:identity:ensure:nonprod": "node scripts/bootstrap-test-identities.mjs --nonprod",
    "test:fixtures": "node scripts/bootstrap-test-fixtures.mjs",
    "test:e2e:identity:create": "node scripts/create-e2e-test-identity.mjs",
    "test:e2e:identity:cleanup": "node scripts/cleanup-test-run.mjs",
    "test:reset": "node scripts/reset-local-test-data.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:staging": "node scripts/run-staging-smoke-tests.mjs",
    "test:collaboration:pilot": "node scripts/run-collaboration-pilot-tests.mjs",
    "collaboration:pilot:report": "node scripts/run-collaboration-pilot.mjs report",
    "collaboration:pilot:enable": "node scripts/run-collaboration-pilot.mjs enable",
    "collaboration:pilot:disable": "node scripts/run-collaboration-pilot.mjs disable",
    "doctor": "node scripts/doctor.mjs",
    "db:link:nonprod": "node scripts/supabase-nonprod.mjs link",
    "db:status": "node scripts/supabase-nonprod.mjs migration list --linked",
    "db:start": "npx --no-install supabase start",
    "db:stop": "npx --no-install supabase stop",
    "db:reset": "npx --no-install supabase db reset --local",
    "db:lint": "npx --no-install supabase db lint --local --level error",
    "db:test": "npx --no-install supabase test db --local",
    "db:types": "npx --no-install supabase gen types typescript --local > src/lib/database.types.ts",
    "db:push:dry-run": "node scripts/supabase-nonprod.mjs db push --linked --dry-run",
    "db:push:nonprod": "node scripts/supabase-nonprod.mjs db push --linked --yes",
    "verify:prod-config": "node scripts/verify-production-config.mjs",
    "verify:antonia-cron": "node scripts/verify-antonia-cron.mjs",
    "verify:scheduler-ownership": "node --loader ./scripts/ts-test-loader.mjs --test functions/scheduler-ownership.test.ts functions/native-research-scheduler.test.ts",
    "repair:contacted-history": "node scripts/repair-contacted-history.mjs",
    "repair:crm-pipeline-history": "node scripts/repair-crm-pipeline-history.mjs",
    "verify:linkedin-profile": "node scripts/verify-linkedin-profile-search.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.17.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.84.0",
    "@types/papaparse": "^5.5.1",
    "apify-client": "^2.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.1.6",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "firebase-admin": "^12.7.0",
    "genkit": "^1.14.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.475.0",
    "next": "15.3.8",
    "next-themes": "^0.3.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.6",
    "genkit-cli": "^1.14.1",
    "postcss": "^8",
    "supabase": "2.115.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
