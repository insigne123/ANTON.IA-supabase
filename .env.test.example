# Test-only environment. Copy to .env.test.local; never point it at production.
APP_ENV="test"
TEST_DATABASE_ENABLED="true"

# Supabase local values come from `npx supabase status -o env` after `db:start`.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-local-service-role-key"
QA_TEST_PASSWORD="replace-with-a-local-only-qa-password"

# This ref is allowed only for explicit nonproduction smoke tests.
SUPABASE_TEST_PROJECT_REF="htketmmhsfmucevvqmxi"

# External effects remain off for local and nonproduction test suites.
OUTBOUND_DELIVERY_MODE="mock"
ALLOW_EXTERNAL_SIDE_EFFECTS="false"
